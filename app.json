{
  "expo": {
    "name": "SkinShelf",
    "slug": "skinshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-release.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.skinshelf.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.skinshelf.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-release.png",
        "backgroundColor": "#FBFAF6"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SkinShelf barkod okutmak ve ürün ekleme akışında kamerayı kullanmak için izin ister."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkinShelf cilt takibi için galerinden fotoğraf seçmene izin verir.",
          "cameraPermission": "SkinShelf cilt takibi fotoğrafı çekmek için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1C4630",
          "defaultChannel": "skinshelf-default"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-release.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 240
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07ea635b-2467-4813-a2e3-a6d5ee49eae0"
      }
    },
    "owner": "cernsvr"
  }
}
