# Backend host secrets. Do not commit real values.
DB_URL="jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0"
DB_USERNAME="postgres.PROJECT_REF"
DB_PASSWORD="REPLACE_WITH_SUPABASE_DB_PASSWORD"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRATION_SECONDS="604800"
CORS_ALLOWED_ORIGINS="https://REPLACE_WITH_WEB_DOMAIN"
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

# Frontend/mobile build env.
EXPO_PUBLIC_API_URL="https://REPLACE_WITH_BACKEND_DOMAIN/api/auth"
EXPO_PUBLIC_LEGAL_BASE_URL="https://REPLACE_WITH_BACKEND_DOMAIN/legal"
